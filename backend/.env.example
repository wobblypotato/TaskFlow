PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/taskflow
# Optional, comma-separated DNS resolver IPs for networks where Node SRV lookups fail.
MONGODB_DNS_SERVERS=
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:5000

# Redis Configuration (BullMQ & Caching)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# Email / SMTP Configuration (Task Reminders)
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="TaskFlow Alerts <notifications@taskflow.local>"
